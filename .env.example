# Copy to .env to set these without typing them each time. Restart the server after changing it.
# A value set in the terminal ($env:BUGS = "...") wins over this file.

# Planted bugs: all, functional, visual, none, or ids separated by commas (see BUGS.md).
BUGS=

# Random delay per API call in ms: "120-350" (default), "0" for none, or a fixed number.
LATENCY=

# Port to try first (default 5180); the next free one is used if it's taken.
PORT=
